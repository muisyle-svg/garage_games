{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garage-games.local/schemas/season.schema.json",
  "title": "Garage Games season",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "timerSeconds", "requiredCompletions", "scoringPolicy",
    "bonusPointsPerGame", "attemptBonusThreshold", "attemptBonusPoints",
    "timeBonusCompletionThreshold", "games"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "timerSeconds": { "type": "integer", "minimum": 1 },
    "requiredCompletions": { "type": "integer", "minimum": 1, "maximum": 20 },
    "scoringPolicy": { "type": "string", "minLength": 1 },
    "bonusPointsPerGame": { "type": "integer", "minimum": 0 },
    "attemptBonusThreshold": { "type": "integer", "minimum": 0, "maximum": 20 },
    "attemptBonusPoints": { "type": "integer", "minimum": 0 },
    "timeBonusCompletionThreshold": { "type": "integer", "minimum": 0, "maximum": 20 },
    "draft": { "type": "boolean" },
    "scoringSettings": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "id", "name", "shortName", "order", "weight" ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1, "maximum": 20 },
          "weight": { "type": "number", "minimum": 0 },
          "enabled": { "type": "boolean" },
          "stationModule": { "type": "string" }
        }
      }
    }
  }
}

